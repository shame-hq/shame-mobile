<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ── Home ─────────────────────────────────────────── -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.shame.tracker.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_active_session"
            app:destination="@id/activeSessionFragment" />
        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_home_to_charts"
            app:destination="@id/chartsFragment" />
        <action
            android:id="@+id/action_home_to_bests"
            app:destination="@id/personalBestsFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- ── Active Session ───────────────────────────────── -->
    <fragment
        android:id="@+id/activeSessionFragment"
        android:name="com.shame.tracker.ui.session.ActiveSessionFragment"
        android:label="Active Run"
        tools:layout="@layout/fragment_active_session">
        <action
            android:id="@+id/action_session_to_summary"
            app:destination="@id/sessionSummaryFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <!-- ── Session Summary ──────────────────────────────── -->
    <fragment
        android:id="@+id/sessionSummaryFragment"
        android:name="com.shame.tracker.ui.summary.SessionSummaryFragment"
        android:label="Run Summary"
        tools:layout="@layout/fragment_session_summary">
        <argument
            android:name="sessionId"
            app:argType="long" />
        <action
            android:id="@+id/action_summary_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ── History ──────────────────────────────────────── -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.shame.tracker.ui.history.HistoryFragment"
        android:label="Run History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_history_to_detail"
            app:destination="@id/sessionDetailFragment" />
    </fragment>

    <!-- ── Session Detail ───────────────────────────────── -->
    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="com.shame.tracker.ui.detail.SessionDetailFragment"
        android:label="Run Detail"
        tools:layout="@layout/fragment_session_detail">
        <argument
            android:name="sessionId"
            app:argType="long" />
    </fragment>

    <!-- ── Charts ───────────────────────────────────────── -->
    <fragment
        android:id="@+id/chartsFragment"
        android:name="com.shame.tracker.ui.charts.ChartsFragment"
        android:label="Charts"
        tools:layout="@layout/fragment_charts" />

    <!-- ── Personal Bests ───────────────────────────────── -->
    <fragment
        android:id="@+id/personalBestsFragment"
        android:name="com.shame.tracker.ui.bests.PersonalBestsFragment"
        android:label="Personal Bests"
        tools:layout="@layout/fragment_personal_bests" />

    <!-- ── Settings ─────────────────────────────────────── -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.shame.tracker.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
