<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Apple-style color palette — Light mode (default) -->
    
    <!-- System Blue (iOS blue) -->
    <color name="system_blue">#007AFF</color>
    <color name="system_blue_light">#5AC8FA</color>
    <color name="system_blue_dark">#0051D5</color>
    
    <!-- System Green -->
    <color name="system_green">#34C759</color>
    <color name="system_green_light">#32D74B</color>
    
    <!-- System Orange (for running) -->
    <color name="system_orange">#FF9F0A</color>
    <color name="system_orange_light">#FFB340</color>
    <color name="system_orange_dark">#CC7700</color>
    
    <!-- System Red -->
    <color name="system_red">#FF3B30</color>
    <color name="system_red_light">#FF453A</color>
    
    <!-- System Purple -->
    <color name="system_purple">#AF52DE</color>
    
    <!-- System Pink -->
    <color name="system_pink">#FF2D92</color>
    
    <!-- System Teal -->
    <color name="system_teal">#30B0C7</color>
    
    <!-- System Indigo -->
    <color name="system_indigo">#5856D6</color>
    
    <!-- System Gray scale (Apple's grays) -->
    <color name="system_gray">#8E8E93</color>
    <color name="system_gray2">#AEAEB2</color>
    <color name="system_gray3">#C7C7CC</color>
    <color name="system_gray4">#D1D1D6</color>
    <color name="system_gray5">#E5E5EA</color>
    <color name="system_gray6">#F2F2F7</color>
    
    <!-- Semantic colors -->
    <color name="label_primary">#000000</color>
    <color name="label_secondary">#3C3C43</color>
    <color name="label_tertiary">#3C3C4399</color>
    <color name="label_quaternary">#3C3C432E</color>
    
    <color name="separator">#3C3C434A</color>
    <color name="separator_opaque">#C6C6C8</color>
    
    <!-- System backgrounds -->
    <color name="system_background">#FFFFFF</color>
    <color name="secondary_system_background">#F2F2F7</color>
    <color name="tertiary_system_background">#FFFFFF</color>
    
    <!-- System grouped backgrounds -->
    <color name="system_grouped_background">#F2F2F7</color>
    <color name="secondary_system_grouped_background">#FFFFFF</color>
    <color name="tertiary_system_grouped_background">#F2F2F7</color>
    
    <!-- System fill colors -->
    <color name="system_fill">#78788033</color>
    <color name="secondary_system_fill">#78788028</color>
    <color name="tertiary_system_fill">#7676801F</color>
    <color name="quaternary_system_fill">#74748014</color>
    
    <!-- App-specific semantic mappings -->
    <color name="primary">@color/system_blue</color>
    <color name="primary_variant">@color/system_blue_dark</color>
    <color name="on_primary">#FFFFFF</color>
    
    <color name="accent">@color/system_orange</color>
    <color name="accent_light">@color/system_orange_light</color>
    <color name="accent_dark">@color/system_orange_dark</color>
    
    <color name="background">@color/system_grouped_background</color>
    <color name="surface">@color/system_background</color>
    <color name="surface_variant">@color/secondary_system_background</color>
    <color name="on_surface">@color/label_primary</color>
    <color name="on_surface_medium">@color/label_secondary</color>
    <color name="on_surface_muted">@color/label_tertiary</color>
    
