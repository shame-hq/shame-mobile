    <color name="chart_blue">@color/system_blue</color>
    <color name="chart_green">@color/system_green</color>
    <color name="chart_orange">@color/system_orange</color>
    <color name="chart_red">@color/system_red</color>
    <color name="chart_purple">@color/system_purple</color>
    <color name="chart_teal">@color/system_teal</color>
    <color name="chart_pink">@color/system_pink</color>
    <color name="chart_indigo">@color/system_indigo</color>
