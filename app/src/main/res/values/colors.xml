    <color name="glass_card_bg">#80FFFFFF</color>
    <color name="glass_card_bg_prominent">#A0FFFFFF</color>
    <color name="glass_card_bg_subtle">#40FFFFFF</color>
    <color name="glass_card_surface">#FFFFFF</color>
    <color name="glass_card_surface_elevated">#FFFFFF</color>
    <color name="glass_card_surface_subtle">#F2F2F7</color>
    <color name="glass_border">#3C3C431A</color>
