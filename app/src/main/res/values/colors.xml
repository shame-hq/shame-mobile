    <color name="lap_1">@color/system_blue</color>
    <color name="lap_2">@color/system_green</color>
    <color name="lap_3">@color/system_orange</color>
    <color name="lap_4">@color/system_red</color>
    <color name="lap_5">@color/system_purple</color>
    <color name="lap_6">@color/system_pink</color>
    
