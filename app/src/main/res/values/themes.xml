<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShameTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_light</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@drawable/bg_light_canvas</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_medium</item>
    </style>

    <style name="Theme.ShameTracker.Splash" parent="Theme.ShameTracker">
        <item name="android:windowBackground">@drawable/bg_dark_canvas</item>
    </style>

    <!-- Glass card styles -->
    <style name="Widget.ShameTracker.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/glass_card_surface</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

    <style name="Widget.ShameTracker.GlassCard.Elevated">
        <item name="cardBackgroundColor">@color/glass_card_surface_elevated</item>
        <item name="strokeColor">@color/glass_border_prominent</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.ShameTracker.GlassCard.Subtle">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">@color/glass_card_surface_subtle</item>
        <item name="strokeColor">@color/glass_border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Typography styles -->
    <style name="TextAppearance.ShameTracker.HeroMetric" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">64sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ShameTracker.LargeMetric" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ShameTracker.MediumMetric" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.ShameTracker.MetricLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/on_surface_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.ShameTracker.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
</resources>
