<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="40dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp">

        <!-- ── Trophy / Achievement Icon Badge ── -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iconBadgeLayout"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/system_green"
            android:background="@color/system_green_light"
            android:padding="20dp"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Subtitle & Title ── -->
        <TextView
            android:id="@+id/tvSummarySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/TextAppearance.ShameTracker.SectionTitle"
            android:text="SESSION FINISHED"
            android:textColor="@color/system_green"
            app:layout_constraintTop_toBottomOf="@id/iconBadgeLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run Complete!"
            style="@style/TextAppearance.ShameTracker.LargeTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSummarySubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSummaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Today"
            style="@style/TextAppearance.ShameTracker.Subheadline"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Main Summary Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSummaryDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Hero Metric: Distance -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.ShameTracker.MetricLabel"
                    android:text="TOTAL DISTANCE" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="true"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:id="@+id/tvSummaryDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        style="@style/TextAppearance.ShameTracker.HeroMetric" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="km"
                        style="@style/TextAppearance.ShameTracker.Title2"
                        android:textColor="@color/system_blue" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/separator_opaque"
                    android:layout_marginBottom="24dp" />

                <!-- 3-Column Secondary Stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <!-- Duration Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/label_tertiary"
                            android:contentDescription="@null"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="TIME" />

                        <TextView
                            android:id="@+id/tvSummaryDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            style="@style/TextAppearance.ShameTracker.MediumMetric"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Pace Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_speed"
                            app:tint="@color/label_tertiary"
                            android:contentDescription="@null"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="PACE" />

                        <TextView
                            android:id="@+id/tvSummaryPace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- /km"
                            style="@style/TextAppearance.ShameTracker.MediumMetric"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Laps Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_flag"
                            app:tint="@color/label_tertiary"
                            android:contentDescription="@null"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="LAPS" />

                        <TextView
                            android:id="@+id/tvSummaryLaps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            style="@style/TextAppearance.ShameTracker.MediumMetric"
                            android:textColor="@color/system_orange"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Done Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            style="@style/Widget.ShameTracker.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Done · Back to Home"
            app:icon="@drawable/ic_check_circle"
            app:iconTint="#FFFFFF"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/cardSummaryDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>