<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- ── Header Section ── -->
        <LinearLayout
            android:id="@+id/headerCharts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ShameTracker.SectionTitle"
                android:text="PERFORMANCE METRICS"
                android:textColor="@color/system_blue" />

            <TextView
                android:id="@+id/tvChartsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/charts"
                style="@style/TextAppearance.ShameTracker.LargeTitle"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trends across your last 10 completed runs"
                style="@style/TextAppearance.ShameTracker.Body"
                android:textColor="@color/label_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Empty State Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutEmptyCharts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/headerCharts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_bar_chart"
                    app:tint="@color/system_blue"
                    android:background="@color/system_gray6"
                    android:padding="12dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Workout Data Yet"
                    style="@style/TextAppearance.ShameTracker.Title3"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complete a run session to unlock distance and lap progression charts."
                    style="@style/TextAppearance.ShameTracker.Body"
                    android:textColor="@color/label_secondary"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Distance Chart Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDistanceChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/headerCharts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_straighten"
                    app:tint="@color/system_blue"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="DISTANCE PER RUN" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Footnote"
                        android:text="Kilometres per session" />
                </LinearLayout>
            </LinearLayout>

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChartDistance"
                android:layout_width="match_parent"
                android:layout_height="220dp" />
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Laps Chart Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLapsChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/cardDistanceChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/system_orange"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.ShameTracker.SectionTitle"
                            android:text="LAPS PER RUN" />

                        <TextView
                            style="@style/TextAppearance.ShameTracker.Footnote"
                            android:text="Total laps completed" />
                    </LinearLayout>
                </LinearLayout>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartLaps"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>