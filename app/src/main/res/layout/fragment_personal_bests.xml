<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- ── Header Section ── -->
        <LinearLayout
            android:id="@+id/headerBests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ShameTracker.SectionTitle"
                android:text="HALL OF FAME"
                android:textColor="@color/system_orange" />

            <TextView
                android:id="@+id/tvBestsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_bests"
                style="@style/TextAppearance.ShameTracker.LargeTitle"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your all-time milestones and workout records"
                style="@style/TextAppearance.ShameTracker.Body"
                android:textColor="@color/label_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Card 1: Longest Distance ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDistanceBest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/headerBests"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_straighten"
                        app:tint="@color/system_blue"
                        android:background="@color/system_gray6"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="LONGEST DISTANCE" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Caption2"
                        android:text="DISTANCE"
                        android:background="@color/glass_border_blue"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBestDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/TextAppearance.ShameTracker.HeroMetric"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Single session peak distance"
                    style="@style/TextAppearance.ShameTracker.Footnote"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Card 2: Most Laps ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLapsBest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/cardDistanceBest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/system_orange"
                        android:background="@color/system_gray6"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="MOST LAPS IN A RUN" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Caption2"
                        android:text="STAMINA"
                        android:background="@color/glass_border_accent"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBestLaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/TextAppearance.ShameTracker.HeroMetric"
                    android:textColor="@color/system_orange"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most circuit laps in one session"
                    style="@style/TextAppearance.ShameTracker.Footnote"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Card 3: Best Pace ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPaceBest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/cardLapsBest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_speed"
                        app:tint="@color/system_green"
                        android:background="@color/system_gray6"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="BEST PACE" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Caption2"
                        android:text="SPEED"
                        android:background="@color/glass_border_green"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBestPace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    style="@style/TextAppearance.ShameTracker.HeroMetric"
                    android:textColor="@color/system_green"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fastest average speed across full run"
                    style="@style/TextAppearance.ShameTracker.Footnote"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Card 4: Total Runs ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotalRuns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/cardPaceBest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_flame"
                        app:tint="@color/system_purple"
                        android:background="@color/system_gray6"
                        android:padding="8dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="TOTAL RUNS COMPLETED" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Caption2"
                        android:text="STREAK"
                        android:background="@color/glass_border_purple"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalRuns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    style="@style/TextAppearance.ShameTracker.HeroMetric"
                    android:textColor="@color/system_purple"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total lifetime tracked sessions"
                    style="@style/TextAppearance.ShameTracker.Footnote"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>