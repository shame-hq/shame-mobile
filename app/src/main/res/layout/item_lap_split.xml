<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    style="@style/Widget.ShameTracker.GlassCard.Subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <!-- Lap color dot -->
        <View
            android:id="@+id/viewLapColor"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_shape" />

        <TextView
            android:id="@+id/tvLapNum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TextAppearance.ShameTracker.Callout"
            android:textColor="@color/label_primary" />

        <TextView
            android:id="@+id/tvLapDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.ShameTracker.Subheadline"
            android:textColor="@color/label_primary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLapTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.ShameTracker.Subheadline"
            android:textColor="@color/label_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLapPace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.ShameTracker.Subheadline"
            android:textColor="@color/system_blue" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>