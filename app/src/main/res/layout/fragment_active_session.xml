<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ── Top Section: Live Metrics ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        style="@style/Widget.ShameTracker.GlassCard.Elevated"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp"
            android:gravity="center_horizontal">

            <!-- Lap & Status Indicator Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Current Lap Pill -->
                <TextView
                    android:id="@+id/tvLap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lap 1"
                    style="@style/TextAppearance.ShameTracker.Caption1"
                    android:textColor="@color/system_orange"
                    android:background="@color/glass_border_accent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Total Session Time Chip -->
                <TextView
                    android:id="@+id/tvSessionTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total 00:00"
                    style="@style/TextAppearance.ShameTracker.Caption1"
                    android:textColor="@color/label_tertiary"
                    android:background="@color/system_fill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Hero Lap Timer -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                style="@style/TextAppearance.ShameTracker.HeroMetric"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <!-- Live Stats Row: Distance & Pace -->
            <LinearLayout
                android:id="@+id/statsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:weightSum="2"
                android:background="@color/tertiary_system_fill"
                android:paddingVertical="10dp"
                android:paddingHorizontal="16dp">

                <!-- Distance Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.MetricLabel"
                        android:text="@string/distance" />

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 km"
                        style="@style/TextAppearance.ShameTracker.LargeMetric"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/separator_opaque"
                    android:alpha="0.3" />

                <!-- Pace Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.MetricLabel"
                        android:text="@string/pace" />

                    <TextView
                        android:id="@+id/tvPace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00 /km"
                        style="@style/TextAppearance.ShameTracker.LargeMetric"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Live Map in Rounded Glass Frame ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        style="@style/Widget.ShameTracker.GlassCard"
        app:layout_constraintTop_toBottomOf="@id/topSection"
        app:layout_constraintBottom_toTopOf="@id/cardLapsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Lap Splits Container ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLapsContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        style="@style/Widget.ShameTracker.GlassCard.Subtle"
        app:layout_constraintBottom_toTopOf="@id/buttonsLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Lap List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextAppearance.ShameTracker.SectionTitle"
                    android:text="LAP SPLITS" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.ShameTracker.Caption2"
                    android:text="DIST · TIME · PACE" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLaps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Bottom Action Dock ── -->
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="34dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- End Session (Destructive) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndSession"
            style="@style/Widget.ShameTracker.Button.Destructive"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/end_session"
            app:icon="@drawable/ic_stop"
            app:iconTint="#FFFFFF"
            app:iconSize="18dp"
            app:iconGravity="textStart" />

        <!-- Pause / Resume -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPause"
            style="@style/Widget.ShameTracker.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/pause_session"
            app:icon="@drawable/ic_pause"
            app:iconTint="@color/system_orange"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            android:textColor="@color/system_orange"
            app:strokeColor="@color/system_orange" />

        <!-- End Lap (Primary Action) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndLap"
            style="@style/Widget.ShameTracker.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.2"
            android:text="@string/end_lap"
            app:icon="@drawable/ic_flag"
            app:iconTint="#FFFFFF"
            app:iconSize="18dp"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>