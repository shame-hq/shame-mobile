<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="40dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- ── Top Header & Greeting ── -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready for a run?"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/label_primary"
                android:includeFontPadding="false"
                android:letterSpacing="0.037" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track route, live laps, and break personal bests."
                android:textSize="17sp"
                android:textColor="@color/label_secondary"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ── Hero Start Run Action ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStartHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/Widget.ShameTracker.GlassCard.Elevated"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.ShameTracker.SectionTitle"
                            android:text="SESSION CONTROL" />

                        <TextView
                            style="@style/TextAppearance.ShameTracker.Title3"
                            android:text="Live GPS &amp; Lap Tracking"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_speed"
                        android:background="@drawable/bg_button_primary_accent"
                        android:padding="10dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStartSession"
                    style="@style/Widget.ShameTracker.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/start_session"
                    android:drawableStart="@drawable/ic_play_arrow"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="12dp"
                    android:paddingHorizontal="32dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Recent Run Dashboard Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLastRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/cardStartHero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/system_blue"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TextAppearance.ShameTracker.SectionTitle"
                        android:text="@string/last_run" />

                    <TextView
                        style="@style/TextAppearance.ShameTracker.Caption2"
                        android:text="RECENT"
                        android:background="@color/glass_border_blue"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastRunInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_recent_run"
                    style="@style/TextAppearance.ShameTracker.Body"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Navigation Tiles Section ── -->
        <TextView
            android:id="@+id/tvExploreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            style="@style/TextAppearance.ShameTracker.SectionTitle"
            android:text="DASHBOARD"
            app:layout_constraintTop_toBottomOf="@id/cardLastRun"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            app:layout_constraintTop_toBottomOf="@id/tvExploreTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- History Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                style="@style/Widget.ShameTracker.GlassCard"
                app:layout_columnWeight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/system_blue"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.Subheadline"
                        android:text="@string/history"
                        android:textColor="@color/label_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Charts Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCharts"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                style="@style/Widget.ShameTracker.GlassCard"
                app:layout_columnWeight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_bar_chart"
                        app:tint="@color/system_teal"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.Subheadline"
                        android:text="@string/charts"
                        android:textColor="@color/label_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personal Bests Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBests"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                style="@style/Widget.ShameTracker.GlassCard"
                app:layout_columnWeight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_workspace_premium"
                        app:tint="@color/system_orange"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.Subheadline"
                        android:text="@string/personal_bests"
                        android:textColor="@color/label_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings Tile -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                style="@style/Widget.ShameTracker.GlassCard"
                app:layout_columnWeight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/label_tertiary"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.ShameTracker.Subheadline"
                        android:text="@string/settings"
                        android:textColor="@color/label_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.gridlayout.widget.GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>