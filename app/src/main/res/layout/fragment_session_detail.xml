<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="32dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp">

        <!-- ── Top Header & Date ── -->
        <LinearLayout
            android:id="@+id/headerDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.ShameTracker.SectionTitle"
                android:text="SESSION SUMMARY"
                android:textColor="@color/system_blue" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Run Detail"
                style="@style/TextAppearance.ShameTracker.LargeTitle"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ── Hero Metrics Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.ShameTracker.SectionCard"
            app:layout_constraintTop_toBottomOf="@id/headerDetail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 3 Columns: Distance, Duration, Laps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <!-- Distance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="DISTANCE" />

                        <TextView
                            android:id="@+id/tvDetailDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 km"
                            style="@style/TextAppearance.ShameTracker.LargeMetric"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/separator_opaque"
                        android:alpha="0.3" />

                    <!-- Duration -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="DURATION" />

                        <TextView
                            android:id="@+id/tvDetailDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            style="@style/TextAppearance.ShameTracker.LargeMetric"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:background="@color/separator_opaque"
                        android:alpha="0.3" />

                    <!-- Laps -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            style="@style/TextAppearance.ShameTracker.MetricLabel"
                            android:text="LAPS" />

                        <TextView
                            android:id="@+id/tvDetailLaps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            style="@style/TextAppearance.ShameTracker.LargeMetric"
                            android:textColor="@color/system_orange"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Hidden/backwards-compatible TextView for legacy tvDetailStats -->
                <TextView
                    android:id="@+id/tvDetailStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Map View ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapContainer"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            style="@style/Widget.ShameTracker.GlassCard"
            app:layout_constraintTop_toBottomOf="@id/cardMetrics"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Replay Controls ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/replayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.ShameTracker.GlassCard.Subtle"
            app:layout_constraintTop_toBottomOf="@id/cardMapContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageButton
                    android:id="@+id/btnReplayPlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="Play replay"
                    android:scaleType="centerInside"
                    android:tint="@color/system_blue" />

                <SeekBar
                    android:id="@+id/seekReplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="16dp"
                    android:thumb="@drawable/seekbar_thumb"
                    android:progressTint="@color/system_blue"
                    android:progressBackgroundTint="@color/system_gray5" />

                <TextView
                    android:id="@+id/tvReplayTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.ShameTracker.Caption1"
                    android:textColor="@color/label_tertiary"
                    android:text="0:00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Bottom Lap Splits Panel ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="200dp"
            style="@style/Widget.ShameTracker.GlassCard"
            app:layout_constraintTop_toBottomOf="@id/replayControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/TextAppearance.ShameTracker.SectionTitle"
                    android:text="LAP BREAKDOWN" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.ShameTracker.Caption2"
                    android:text="DIST · TIME · PACE" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetailLaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>